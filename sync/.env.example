# Zenith Settings Sync Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_NAME=zenith_sync
DB_USER=zenith_sync_user
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4

# AWS SES Configuration
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@zenithtracker.org

# Application URLs
SYNC_BASE_URL=https://sync.zenithtracker.org
MAIN_APP_URL=https://zenithtracker.org

# Security Settings
MAGIC_LINK_EXPIRY_MINUTES=15
RATE_LIMIT_MAGIC_LINK_PER_HOUR=3
RATE_LIMIT_API_CALLS_PER_MINUTE=100
SETTINGS_MAX_SIZE_MB=1

# Admin Configuration (Optional)
ADMIN_KEY=your_secure_admin_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://zenithtracker.org,https://www.zenithtracker.org

# Development/Testing
ENVIRONMENT=production
TEST_MODE=false
LOG_ERRORS=true
LOG_FILE_PATH=/var/log/zenith_sync/errors.log
